# Local mode: embedded PostgreSQL on disk and private local files.
DATA_DIR=.data
AUTH_PROVIDER=local
# Enable the local administrator's "Sign in without password" button on loopback only.
LOCAL_PASSWORDLESS_LOGIN=false
DEMO_SEED=true
DEMO_PASSWORD=replace-with-a-long-local-password
APP_ORIGIN=http://localhost:3000
COMPANY_TIMEZONE=Asia/Qyzylorda
# Optional production PostgreSQL/Supabase; no secrets use NEXT_PUBLIC_.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
# AUTH_PROVIDER=supabase
# SUPABASE_URL=https://project.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_PROVIDER=supabase
# SUPABASE_STORAGE_BUCKET=adasset-private
# CRON_SECRET=replace-with-random-secret
# NEXT_PUBLIC_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
